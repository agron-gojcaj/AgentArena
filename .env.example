# Fake agents run without credentials. Real models require a worker-only key.
OPENAI_API_KEY=
POSTGRES_PASSWORD=agentarena-local
# Hard cap on cumulative estimated provider spend (USD). Restarting preserves spend.
PROJECT_BUDGET_USD=5.00
MAX_CONCURRENT_RUNS=2
MAX_QUEUED_RUNS=20
# Pricing assumptions per million tokens; review before using real models.
MODEL_PRICING_JSON={"gpt-4.1-mini":{"input":0.40,"output":1.60}}
